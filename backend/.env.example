NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://guanzhi:change-me@localhost:5432/guanzhi
DB_POOL_MAX=10

# 至少 32 字符；生产环境必须替换
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# 首次初始化管理员（仅 db:seed 使用）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# 多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# 可选：Resend 通知；留空则只入库
RESEND_API_KEY=
NOTIFICATION_FROM=website@example.com
NOTIFICATION_TO=hello@example.com

# 反垃圾：仅保存不可逆 IP 摘要
IP_HASH_SALT=replace-with-another-random-secret
