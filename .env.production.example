# 观止东方 · 生产部署配置
# 服务器上复制为 .env 并填入实际值。此文件绝不提交 Git。
# 生成强随机值：
#   Linux/macOS: openssl rand -hex 32
#   PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=guanzhi
POSTGRES_USER=guanzhi_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ── API / Fastify ───────────────────────────────────────────
API_PORT=8080
# 前端由 Caddy 容器反代，API 只绑定本机回环，不直接暴露公网
API_BIND_HOST=127.0.0.1
LOG_LEVEL=info
JWT_SECRET=CHANGE_ME_64_HEX
JWT_EXPIRES_IN=8h

# 首个管理员（首次启动 seed 后建议立即改密码）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 生产域名（Caddy 自动签发 TLS；多个用逗号分隔）
CORS_ORIGINS=https://your-domain.com
PUBLIC_BASE_URL=https://your-domain.com
# Caddy 站点域名：多域名时取主域名（默认取 CORS_ORIGINS 第一个）
# PROD_SITE_DOMAIN=https://your-domain.com

# ── 安全 ────────────────────────────────────────────────────
IP_HASH_SALT=CHANGE_ME_64_HEX
# 站点经 Caddy 反代到 API，跳数为 1
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false

# ── 通知（可选，合作询盘邮件通知）──────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=
