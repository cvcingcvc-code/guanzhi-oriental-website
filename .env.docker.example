# 复制为 .env 后再执行 docker compose up。生产环境必须替换所有 change/local 值。
POSTGRES_DB=guanzhi
POSTGRES_USER=guanzhi
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_PORT=5432

API_PORT=8080
API_BIND_HOST=127.0.0.1
LOG_LEVEL=info
DB_POOL_MAX=10
JWT_SECRET=change-this-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
IP_HASH_SALT=change-this-ip-hash-salt

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 本地开发填前端地址（Vite 3000）：CMS 上传媒体会以 PUBLIC_BASE_URL 拼成绝对 URL，
# 指向 8080 会与页面不同源，浏览器按 CORP 拦截（ERR_BLOCKED_BY_RESPONSE.NotSameOrigin）。
# 生产填站点域名（与 CORS_ORIGINS 一致），由 Caddy 反代 /uploads/*。
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true

# 可选邮件通知
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=
